<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Droit CarPlay « driving task ». À n'utiliser QUE lorsque Apple l'a accordé au compte développeur
  (compte payant + demande sur https://developer.apple.com/carplay). Pour l'activer, ajouter dans
  project.yml, cible TrackGauge > settings > base :  CODE_SIGN_ENTITLEMENTS: App/TrackGauge-CarPlay.entitlements
  Sans ce droit dans le profil de signature, iOS refuse l'installation.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
</dict>
</plist>
